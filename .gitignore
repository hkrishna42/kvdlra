.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.env
.env.*
wandb/
dumps/**
*.ckpt
*.safetensors
results/*.csv
figs/*.pdf
figs/*.png
!figs/.gitkeep
!dumps/.gitkeep
!results/.gitkeep

# macOS
.DS_Store

# Raw planning artifact lives in the repo as docs/PLAN.md; keep the original
# on disk but out of the published tree.
compass_artifact_*.md

# .env.* (above) would also swallow the committed template; keep it tracked.
!.env.example

# uv lockfile: platform-specific (Mac-CPU here vs. the CUDA pod) and large;
# pyproject.toml's exact pins are the source of truth. Keeps the large-files
# pre-commit guard tight for catching stray tensors/checkpoints.
uv.lock

# Local handoff / internal notes — keep out of the (public) repo entirely.
handover.md
explanation_week_1_2.md
explanation_week_3_4.md
