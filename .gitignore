.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.env
.env.*
wandb/
dumps/**
*.ckpt
*.safetensors
results/*.csv
figs/*.pdf
figs/*.png
!figs/.gitkeep
!dumps/.gitkeep
# The dumps themselves stay out (4.7 GB); their sha256 manifest is the committed
# identity of the tree -- scripts/dump_kv.py verify --dir dumps/llama3.2-1b.
!dumps/*.sha256
!results/.gitkeep

# macOS
.DS_Store

# Raw planning artifact lives in the repo as docs/PLAN.md; keep the original
# on disk but out of the published tree.
compass_artifact_*.md

# .env.* (above) would also swallow the committed template; keep it tracked.
!.env.example

# uv lockfile: platform-specific (Mac-CPU here vs. the CUDA pod) and large;
# pyproject.toml's exact pins are the source of truth. Keeps the large-files
# pre-commit guard tight for catching stray tensors/checkpoints.
uv.lock

# Local handoff / internal notes — keep out of the (public) repo entirely.
handover.md
explanation_week_1_2.md
explanation_week_3_4.md
explanation_week_5_6.md
next-session-prompt.md
results/gpu_logs/

# Session-generated research dashboards (not part of the library)
dashboards/

# Claude Code local worktrees (never commit)
.claude/worktrees/

# scratch plots from local smoke runs (never clobber tracked figures)
figures/scratch/
results/scratch/

# Generated figure output: `make figures` writes it, `make clean` deletes it. The
# tables next door are generated AND committed because the paper cites their numbers;
# the figures are rebuilt from the same records on demand.
docs/paper/figures/

# Per-pod runtime files: the launcher's instance list, the watchdog's accumulated log
# rows and its liveness/status files. The committed evidence for a pod is the records
# and their manifest -- trials.jsonl, ppl.jsonl, pplw.jsonl, diag.jsonl, manifest.json,
# env.txt -- and those are NOT matched here.
results/*/pods.txt
results/*/done.txt
results/*/*.raw
results/*/watchdog.pid
results/*/status.txt
results/*/*.log
paper/arxiv/
paper/arxiv-v1.tar.gz
paper/main.bbl
paper/main.pdf
